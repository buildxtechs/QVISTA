{
  "include": [
    "backend"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "backend/venv",
    ".venv"
  ],
  "venvPath": ".",
  "venv": ".venv",
  "extraPaths": [
    "backend",
    "backend/app"
  ],
  "typeCheckingMode": "basic",
  "reportAttributeAccessIssue": false,
  "reportGeneralTypeIssues": false,
  "reportMissingTypeStubs": false,
  "reportDeprecated": false
}
