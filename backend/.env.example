# Copy this file to .env and fill in real values before running the backend.

# SQLite is fine to start. For production, point this at Postgres, e.g.:
# DATABASE_URL=postgresql://vulnops:password@localhost:5432/vulnops
DATABASE_URL=sqlite:///./vulnops.db

# REQUIRED: generate with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This key encrypts your Qualys password at rest. Keep it out of source control.
CREDENTIAL_ENCRYPTION_KEY=

SECRET_KEY=change-me-in-production

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
